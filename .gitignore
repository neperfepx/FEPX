# Build trees
build/
build-*/
/build*/

# Fortran compiler outputs
*.o
*.mod
*.smod
*.a
*.so

# Reference PDFs and the v2 source archive: local only, never committed (CLAUDE.md §1)
refs/

# Python caches (development tools)
__pycache__/
*.pyc

# Editor files
*.swp
*~
.vscode/
.idea/

# Benchmark meshes and run directories (regenerated by dev/benchmarks/*/generate_mesh.sh)
dev/benchmarks/**/*.msh
dev/benchmarks/**/*.tess
dev/benchmarks/**/runs/
dev/benchmarks/**/tmp*.geo
dev/benchmarks/**/failed_polys
dev/benchmarks/**/mesh.log
dev/benchmarks/**/mesh.time

# LaTeX build files of an in-tree latexmk run (the CI builds into build-ci-logs/theory-pdf/)
dev/theory/latex/*.aux
dev/theory/latex/*.fdb_latexmk
dev/theory/latex/*.fls
dev/theory/latex/*.log
dev/theory/latex/*.out
dev/theory/latex/*.pdf
dev/theory/latex/*.toc

# Claude Code personal settings (not shared)
.claude/settings.local.json
